<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chamuka | Cloud Music Player</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root { --green: #1DB954; --dark: #121212; --card: #1f1f1f; }
        body { background: #000; color: white; font-family: 'Segoe UI', system-ui; overflow: hidden; }
        
        .app { display: flex; height: 100vh; flex-direction: column; }
        .main { display: flex; flex: 1; overflow: hidden; }
        
        /* Sidebar */
        .sidebar { width: 260px; background: #000; padding: 30px 20px; border-right: 1px solid #282828; }
        .logo { font-size: 28px; font-weight: bold; color: var(--green); margin-bottom: 40px; }
        .nav-item { padding: 12px; margin: 8px 0; border-radius: 8px; cursor: pointer; transition: 0.2s; }
        .nav-item:hover, .nav-item.active { background: #282828; }
        .nav-item i { width: 30px; }
        
        /* Main content */
        .content { flex: 1; overflow-y: auto; background: linear-gradient(180deg, #1f1f1f 0%, #0a0a0a 100%); }
        .header { position: sticky; top: 0; background: rgba(0,0,0,0.9); backdrop-filter: blur(10px); padding: 20px 30px; z-index: 10; }
        .search-box { background: #2a2a2a; border-radius: 30px; padding: 12px 20px; display: inline-flex; width: 400px; gap: 15px; }
        .search-box input { background: none; border: none; color: white; font-size: 16px; width: 100%; outline: none; }
        
        /* Song grid */
        .songs-container { padding: 20px 30px; }
        .song-card { background: var(--card); border-radius: 12px; padding: 16px; margin-bottom: 10px; display: flex; align-items: center; gap: 20px; transition: 0.2s; }
        .song-card:hover { background: #2a2a2a; transform: translateX(5px); }
        .song-info { flex: 2; }
        .song-title { font-weight: 600; font-size: 16px; }
        .song-artist { color: #b3b3b3; font-size: 14px; margin-top: 4px; }
        .song-album { flex: 1; color: #b3b3b3; font-size: 14px; }
        .controls { display: flex; gap: 12px; align-items: center; }
        .btn-icon { background: none; border: none; color: white; font-size: 20px; cursor: pointer; padding: 8px; border-radius: 50%; transition: 0.2s; width: 40px; height: 40px; }
        .btn-icon:hover { background: var(--green); color: black; transform: scale(1.05); }
        .download-btn { background: #333; padding: 8px 16px; border-radius: 30px; text-decoration: none; color: white; font-size: 13px; transition: 0.2s; }
        .download-btn:hover { background: var(--green); color: black; }
        
        /* Now playing bar */
        .player-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #181818; border-top: 1px solid #282828; padding: 16px 30px; display: flex; align-items: center; gap: 20px; z-index: 100; }
        .track-info { min-width: 200px; }
        .track-title { font-weight: 600; }
        .player-controls { display: flex; gap: 20px; }
        .progress-section { flex: 2; display: flex; align-items: center; gap: 15px; }
        .progress-bar { flex: 1; height: 4px; background: #535353; border-radius: 4px; cursor: pointer; }
        .progress-fill { height: 100%; background: var(--green); border-radius: 4px; width: 0%; }
        .time { font-size: 12px; color: #b3b3b3; }
        .playing-badge { background: var(--green); color: black; font-size: 10px; padding: 2px 8px; border-radius: 20px; margin-left: 10px; font-weight: bold; }
        
        .sync-status { position: fixed; bottom: 80px; right: 20px; background: #282828; padding: 8px 16px; border-radius: 20px; font-size: 12px; z-index: 99; }
        @media (max-width: 768px) { .sidebar { display: none; } .search-box { width: 100%; } .song-card { flex-wrap: wrap; } }
    </style>
</head>
<body>
<div class="app">
    <div class="main">
        <aside class="sidebar">
            <div class="logo">🎵 CHAMUKA</div>
            <nav>
                <div class="nav-item active"><i class="fas fa-home"></i> Library</div>
                <div class="nav-item" id="syncBtn"><i class="fas fa-sync-alt"></i> Sync Drive</div>
            </nav>
        </aside>
        
        <div class="content">
            <div class="header">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchInput" placeholder="Search songs from your Google Drive...">
                </div>
            </div>
            <div class="songs-container" id="songsContainer">
                <div style="text-align: center; padding: 50px;"><i class="fas fa-spinner fa-pulse"></i> Loading your music library...</div>
            </div>
        </div>
    </div>
    
    <div class="player-bar">
        <div class="track-info">
            <div class="track-title" id="nowPlayingTitle">Select a song</div>
            <div style="font-size: 12px; color:#b3b3b3" id="nowPlayingArtist">—</div>
        </div>
        <div class="player-controls">
            <button class="btn-icon" id="prevBtn"><i class="fas fa-backward-step"></i></button>
            <button class="btn-icon" id="playPauseBtn"><i class="fas fa-play"></i></button>
            <button class="btn-icon" id="nextBtn"><i class="fas fa-forward-step"></i></button>
        </div>
        <div class="progress-section">
            <span class="time" id="currentTime">0:00</span>
            <div class="progress-bar" id="progressBar"><div class="progress-fill" id="progressFill"></div></div>
            <span class="time" id="duration">0:00</span>
        </div>
    </div>
    <div class="sync-status" id="syncStatus">✅ Ready</div>
    
    <script>
        const API_BASE = 'http://localhost:3000/api';
        let currentSongs = [];
        let currentQueue = [];
        let currentIndex = 0;
        let audio = new Audio();
        let isPlaying = false;
        
        // DOM elements
        const songsContainer = document.getElementById('songsContainer');
        const searchInput = document.getElementById('searchInput');
        const playPauseBtn = document.getElementById('playPauseBtn');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');
        const progressBar = document.getElementById('progressBar');
        const progressFill = document.getElementById('progressFill');
        const currentTimeSpan = document.getElementById('currentTime');
        const durationSpan = document.getElementById('duration');
        const nowPlayingTitle = document.getElementById('nowPlayingTitle');
        const nowPlayingArtist = document.getElementById('nowPlayingArtist');
        const syncStatus = document.getElementById('syncStatus');
        
        // Helper functions
        function formatTime(sec) { if (!sec) return '0:00'; const m = Math.floor(sec/60); const s = Math.floor(sec%60); return `${m}:${s.toString().padStart(2,'0')}`; }
        
        async function fetchSongs(search = '') {
            try {
                const url = `${API_BASE}/songs?search=${encodeURIComponent(search)}&limit=100`;
                const res = await fetch(url);
                const data = await res.json();
                currentSongs = data.results || [];
                currentQueue = [...currentSongs];
                renderSongs(currentSongs);
                if (currentSongs.length === 0) songsContainer.innerHTML = '<div style="text-align:center;padding:50px;">🎵 No songs found. Click "Sync Drive" to load your music.</div>';
            } catch (err) {
                console.error(err);
                songsContainer.innerHTML = '<div style="text-align:center;padding:50px;color:red;">⚠️ Cannot connect to server. Make sure backend is running.</div>';
            }
        }
        
        function renderSongs(songs) {
            if (!songs.length) { songsContainer.innerHTML = '<div style="text-align:center;padding:50px;">✨ No matching songs</div>'; return; }
            songsContainer.innerHTML = songs.map((song, idx) => `
                <div class="song-card" data-id="${song.driveId}" data-index="${idx}">
                    <div class="song-info">
                        <div class="song-title">${escapeHtml(song.title)} ${currentQueue[currentIndex]?.driveId === song.driveId ? '<span class="playing-badge">NOW PLAYING</span>' : ''}</div>
                        <div class="song-artist">${escapeHtml(song.artist)}</div>
                    </div>
                    <div class="song-album"><i class="fas fa-album"></i> ${escapeHtml(song.album)}</div>
                    <div class="controls">
                        <button class="btn-icon play-this" data-id="${song.driveId}"><i class="fas fa-play"></i></button>
                        <a href="${song.downloadUrl}" class="download-btn" download target="_blank"><i class="fas fa-download"></i> MP3</a>
                    </div>
                </div>
            `).join('');
            
            document.querySelectorAll('.play-this').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const id = btn.dataset.id;
                    const songIndex = currentQueue.findIndex(s => s.driveId === id);
                    if (songIndex !== -1) playSong(songIndex);
                });
            });
        }
        
        function escapeHtml(str) { if(!str) return ''; return str.replace(/[&<>]/g, function(m){if(m==='&') return '&amp;'; if(m==='<') return '&lt;'; if(m==='>') return '&gt;'; return m;}); }
        
        async function playSong(index) {
            if (!currentQueue[index]) return;
            currentIndex = index;
            const song = currentQueue[index];
            nowPlayingTitle.textContent = song.title;
            nowPlayingArtist.textContent = song.artist;
            
            // Use stream endpoint for playback
            audio.src = `${API_BASE}/stream/${song.driveId}`;
            audio.load();
            audio.play().catch(e => console.log('Autoplay blocked, click play', e));
            isPlaying = true;
            playPauseBtn.innerHTML = '<i class="fas fa-pause"></i>';
            renderSongs(currentSongs);
        }
        
        function togglePlayPause() {
            if (!audio.src) { if(currentQueue[0]) playSong(0); return; }
            if (audio.paused) { audio.play(); isPlaying = true; playPauseBtn.innerHTML = '<i class="fas fa-pause"></i>'; }
            else { audio.pause(); isPlaying = false; playPauseBtn.innerHTML = '<i class="fas fa-play"></i>'; }
        }
        
        function nextSong() { if (currentIndex + 1 < currentQueue.length) playSong(currentIndex + 1); else if (currentQueue.length) playSong(0); }
        function prevSong() { if (currentIndex - 1 >= 0) playSong(currentIndex - 1); else if (currentQueue.length) playSong(currentQueue.length - 1); }
        
        async function syncWithDrive() {
            syncStatus.innerHTML = '🔄 Syncing from Google Drive...';
            syncStatus.style.background = '#1DB954';
            try {
                const res = await fetch(`${API_BASE}/sync`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    syncStatus.innerHTML = `✅ Synced ${data.count} songs!`;
                    await fetchSongs(searchInput.value);
                    setTimeout(() => { syncStatus.innerHTML = '✅ Ready'; }, 3000);
                } else throw new Error(data.error);
            } catch(err) {
                syncStatus.innerHTML = '❌ Sync failed';
                syncStatus.style.background = '#e74c3c';
                console.error(err);
            }
        }
        
        // Event listeners
        searchInput.addEventListener('input', (e) => fetchSongs(e.target.value));
        playPauseBtn.addEventListener('click', togglePlayPause);
        nextBtn.addEventListener('click', nextSong);
        prevBtn.addEventListener('click', prevSong);
        document.getElementById('syncBtn').addEventListener('click', syncWithDrive);
        
        audio.addEventListener('timeupdate', () => {
            if (audio.duration) {
                const percent = (audio.currentTime / audio.duration) * 100;
                progressFill.style.width = `${percent}%`;
                currentTimeSpan.textContent = formatTime(audio.currentTime);
                durationSpan.textContent = formatTime(audio.duration);
            }
        });
        audio.addEventListener('ended', nextSong);
        progressBar.addEventListener('click', (e) => {
            const rect = progressBar.getBoundingClientRect();
            const percent = (e.clientX - rect.left) / rect.width;
            if (audio.duration) audio.currentTime = percent * audio.duration;
        });
        
        // Initialize
        fetchSongs();
    </script>
</body>
</html>